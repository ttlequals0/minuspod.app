---
import { formatLength, posterUrl, videoUrl, watchPath } from '../lib/video';

interface Props {
  name: string;
  title: string;
  seconds: number;
  description?: string;
  caption?: boolean;
}

const { name, title, seconds, description, caption = true } = Astro.props;
const length = formatLength(seconds);
// without a caption the poster carries the text instead
const alt = caption ? `Still from ${title}` : [title, description, length].filter(Boolean).map((t) => t.replace(/\.$/, '')).join('. ');
---

<figure class="video-card" data-video-card data-name={name} data-title={title}>
  <div class="frame">
    <picture>
      <source srcset={`/videos/${name}-portrait.jpg`} media="not all and (min-width: 768px)" />
      <img src={posterUrl(name)} alt={alt} width="1920" height="1080" loading="lazy" />
    </picture>
    <a class="play" href={videoUrl(name)} aria-label={`Play ${title}`}>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    </a>
  </div>
  {caption && (
    <figcaption>
      <h3><a href={watchPath(name)}>{title}</a></h3>
      {description && <p>{description}</p>}
      <p class="length">{length}</p>
    </figcaption>
  )}
</figure>

<script>
  import { playInPlace } from '../../../shared/video.js';

  for (const card of document.querySelectorAll<HTMLElement>('[data-video-card]')) {
    const play = card.querySelector<HTMLAnchorElement>('.play');
    play?.addEventListener('click', (e) => {
      e.preventDefault();
      const wide = matchMedia('(min-width: 768px)').matches;
      playInPlace((video) => card.querySelector('.frame')?.replaceChildren(video), {
        src: wide ? play.href : play.href.replace(/-landscape\.mp4$/, '.mp4'),
        poster: `/videos/${card.dataset.name}-${wide ? 'landscape' : 'portrait'}.jpg`,
        title: card.dataset.title ?? '',
        img: card.querySelector('img'),
      });
    });
  }
</script>
