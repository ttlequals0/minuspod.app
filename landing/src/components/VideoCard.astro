---
import { formatLength, videoUrl } from '../lib/video';

interface Props {
  name: string;
  title: string;
  seconds: number;
  description?: string;
  caption?: boolean;
}

const { name, title, seconds, description, caption = true } = Astro.props;
const length = formatLength(seconds);
// without a caption the poster carries the text instead
const alt = caption ? '' : [title, description, length].filter(Boolean).map((t) => t.replace(/\.$/, '')).join('. ');
---

<figure class="video-card" data-video-card data-name={name} data-title={title}>
  <div class="frame">
    <picture>
      <source srcset={`/videos/${name}-portrait.jpg`} media="not all and (min-width: 768px)" />
      <img src={`/videos/${name}-landscape.jpg`} alt={alt} width="1920" height="1080" loading="lazy" />
    </picture>
    <a class="play" href={videoUrl(name)} aria-label={`Play ${title}`}>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    </a>
  </div>
  {caption && (
    <figcaption>
      <h3>{title}</h3>
      {description && <p>{description}</p>}
      <p class="length">{length}</p>
    </figcaption>
  )}
</figure>

<script>
  for (const card of document.querySelectorAll<HTMLElement>('[data-video-card]')) {
    const play = card.querySelector<HTMLAnchorElement>('.play');
    play?.addEventListener('click', (e) => {
      e.preventDefault();
      const wide = matchMedia('(min-width: 768px)').matches;
      const img = card.querySelector('img');
      const video = document.createElement('video');
      video.controls = true;
      video.playsInline = true;
      video.preload = 'none';
      video.poster = `/videos/${card.dataset.name}-${wide ? 'landscape' : 'portrait'}.jpg`;
      // keep the poster's box while the player loads
      if (img?.naturalWidth) video.style.aspectRatio = `${img.naturalWidth} / ${img.naturalHeight}`;
      // iOS never loads a preload=none video built from <source> children; set src directly
      video.src = wide ? play.href : play.href.replace(/-landscape\.mp4$/, '.mp4');
      video.setAttribute('aria-label', card.dataset.title ?? '');
      card.querySelector('.frame')?.replaceChildren(video);
      video.focus();
      video.play().catch((err) => console.warn('video play failed', err));
    });
  }
</script>
