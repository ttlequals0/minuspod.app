---
const tabs = [
  { id: 'videos', label: 'Videos' },
  { id: 'screenshots', label: 'Screenshots' },
];
---

<div class="tabs" data-tabs>
  <div class="tablist" role="tablist" aria-label="Gallery sections">
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>{t.label}</button>
    ))}
  </div>
  {tabs.map((t) => (
    <section class="tabpanel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`}>
      <h2 class="panel-heading">{t.label}</h2>
      <slot name={t.id} />
    </section>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    root.dataset.enhanced = '';
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (id: string, focus = false, push = true) => {
      for (const tab of tabs) {
        const on = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`)!.hidden = !on;
        if (on && focus) tab.focus();
      }
      if (push) history.replaceState(null, '', `?tab=${id}`);
    };
    const wanted = new URLSearchParams(location.search).get('tab');
    select(tabs.some((t) => t.dataset.tab === wanted) ? wanted! : 'videos', false, false);
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.tab!));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in keys)) return;
        e.preventDefault();
        select(tabs[(keys[e.key] + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });
  }
</script>
