---
import stats from '../../../shared/generated/repo-stats.json';
import { REPO_URL, formatCount } from '../../../shared/repo.mjs';

// repo-stats.mjs writes nulls when the GitHub API was unreachable at build time
const stars = stats.stars === null ? null : formatCount(stats.stars);
const forks = stats.forks === null ? null : formatCount(stats.forks);
const label = stars === null ? 'MinusPod on GitHub' : `MinusPod on GitHub: ${stars} stars, ${forks} forks`;
const icon = { width: 16, height: 16, viewBox: '0 0 16 16', 'aria-hidden': 'true', focusable: 'false' };
// Octicons mark-github, star and repo-forked (MIT, GitHub Inc.)
---

<a class="repo-stats" href={REPO_URL} aria-label={label}>
