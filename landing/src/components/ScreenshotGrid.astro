---
interface Group {
  label: string;
  files: { file: string; kind: 'desktop' | 'mobile' | 'single'; w: number; h: number }[];
}

const { groups } = Astro.props as { groups: Group[] };
const altFor = { desktop: (l: string) => `${l}, desktop`, mobile: (l: string) => `${l}, phone`, single: (l: string) => l };
---

<div class="shots">
  {groups.map((g) => (
    <figure class="shot">
      <div class={`shot-images shot-${g.files.length > 1 ? 'pair' : 'one'}`}>
        {g.files.map((f) => (
          <img class={`shot-${f.kind}`} src={`/screenshots/${f.file}`} alt={altFor[f.kind](g.label)} width={f.w} height={f.h} loading="lazy" decoding="async" />
        ))}
      </div>
      <figcaption>{g.label}</figcaption>
    </figure>
  ))}
</div>
