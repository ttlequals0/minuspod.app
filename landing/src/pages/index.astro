---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import VideoCard from '../components/VideoCard.astro';
import videos from '../generated/videos.json';
import { pitch } from '../generated/pitch.json';
import { SOCIAL_IMAGE_PATH, hasSocialImage } from '../../../shared/social.mjs';
import { REPO_URL } from '../../../shared/repo.mjs';

const demo = videos.find((v) => v.name === 'demo');
const description = pitch.split('. ')[0] + '.';
const detail = pitch.slice(description.length).trim();
const title = 'MinusPod: self-hosted ad removal for podcasts and YouTube';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'MinusPod',
  url: new URL('/', Astro.site).href,
  description: pitch,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Linux, Docker',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: `${REPO_URL}/blob/main/LICENSE`,
  codeRepository: REPO_URL,
  softwareHelp: 'https://docs.minuspod.app/',
  ...(hasSocialImage(videos) && { screenshot: new URL(SOCIAL_IMAGE_PATH, Astro.site).href }),
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <h1>
      <span class="sr-only">MinusPod</span>
      <img class="logo-light" src="/brand/logo.svg" alt="" width="520" height="160" aria-hidden="true" />
      <img class="logo-dark" src="/brand/logo-dark.svg" alt="" width="520" height="160" aria-hidden="true" />
    </h1>
    <p class="pitch">{description}</p>
    <div class="actions">
      <Button variant="primary" href={REPO_URL}>View on GitHub</Button>
      <Button variant="secondary" href="https://demo.minuspod.app/">Try the demo</Button>
    </div>
    <p class="detail">{detail}</p>
  </section>
  {demo && (
    <section class="tour" aria-labelledby="tour-heading">
      <h2 id="tour-heading">A tour of the web UI</h2>
      <VideoCard name={demo.name} title={demo.title} seconds={demo.seconds} description={demo.description} caption={false} />
    </section>
  )}
</Base>
