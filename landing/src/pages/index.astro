---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import VideoCard from '../components/VideoCard.astro';
import videos from '../generated/videos.json';
import { pitch } from '../generated/pitch.json';

const demo = videos.find((v) => v.name === 'demo');
const description = pitch.split('. ')[0] + '.';
---

<Base title="MinusPod" description={description}>
  <section class="hero">
    <h1>MinusPod</h1>
    <p class="pitch">{pitch}</p>
    <div class="actions">
      <Button variant="primary" href="https://github.com/ttlequals0/MinusPod">View on GitHub</Button>
      <Button variant="secondary" href="https://demo.minuspod.app/">Try the demo</Button>
    </div>
  </section>
  {demo && (
    <section class="tour" aria-labelledby="tour-heading">
      <h2 id="tour-heading">A tour of the web UI</h2>
      <VideoCard name={demo.name} title={demo.title} seconds={demo.seconds} description={demo.description} headingLevel={3} />
    </section>
  )}
</Base>
