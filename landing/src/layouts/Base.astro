---
import '../../../shared/generated/tokens.css';
import { beaconToken } from '../../../shared/beacon.mjs';
import '../styles/site.css';
import bootstrap from '../../../shared/theme/bootstrap.js?raw';
import ThemePicker from '../components/ThemePicker.astro';
import RepoStats from '../components/RepoStats.astro';
import videos from '../generated/videos.json';
import { SITE_NAME, SOCIAL_IMAGE_ALT, SOCIAL_IMAGE_PATH, hasSocialImage } from '../../../shared/social.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  social?: { path: string; alt: string; video?: string };
}

const { title, description, noindex = false, jsonLd, social } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const pageUrl = new URL(path, Astro.site).href;
const card = social ?? (hasSocialImage(videos) ? { path: SOCIAL_IMAGE_PATH, alt: SOCIAL_IMAGE_ALT } : null);
const image = card && new URL(card.path, Astro.site).href;
const token = beaconToken(import.meta.env.PUBLIC_CF_BEACON_TOKEN_LANDING);
const nav = [
  { label: 'Docs', href: 'https://docs.minuspod.app/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Demo', href: 'https://demo.minuspod.app/' },
  { label: 'FAQ', href: '/#faq' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={bootstrap} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={pageUrl} />
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
        <meta property="og:url" content={pageUrl} />
      </>
    )}
    <meta property="og:site_name" content="MinusPod" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={social?.video ? 'video.other' : 'website'} />
    {social?.video && <meta property="og:video" content={new URL(social.video, Astro.site).href} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:alt" content={card.alt} />
        <meta name="twitter:image:alt" content={card.alt} />
      </>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <link rel="icon" href="/brand/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    {token && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token })}></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell bar">
        <a class="brand" href="/" aria-label="MinusPod home">
          <img class="logo-light" src="/brand/logo.svg" alt="MinusPod" width="130" height="40" />
          <img class="logo-dark" src="/brand/logo-dark.svg" alt="MinusPod" width="130" height="40" />
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <ThemePicker />
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell bar">
        <RepoStats />
        <a class="reddit" href="https://www.reddit.com/r/MinusPod/" aria-label="r/MinusPod on Reddit">
          {/* Starlight's built-in reddit icon (MIT) */}
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.41 16.87a3.38 3.38 0 0 1-2.37.63 3.37 3.37 0 0 1-2.36-.63 1 1 0 0 0-1.42 1.41 5.11 5.11 0 0 0 3.78 1.22 5.12 5.12 0 0 0 3.78-1.22 1 1 0 1 0-1.41-1.41ZM9.2 15a1 1 0 1 0-1-1 1 1 0 0 0 1 1Zm6-2a1 1 0 1 0 1 1 1 1 0 0 0-1-1Zm7.8-1.22a3.77 3.77 0 0 0-6.8-2.26 16.5 16.5 0 0 0-3.04-.48l.85-5.7 2.09.7a3 3 0 0 0 6-.06v-.02a3.03 3.03 0 0 0-3-2.96 2.98 2.98 0 0 0-2.34 1.16l-3.24-1.1a1 1 0 0 0-1.3.8l-1.09 7.17a16.66 16.66 0 0 0-3.34.49 3.77 3.77 0 0 0-6.22 4.23A4.86 4.86 0 0 0 1 16c0 3.92 4.83 7 11 7s11-3.08 11-7a4.86 4.86 0 0 0-.57-2.25 3.78 3.78 0 0 0 .57-1.97ZM19.1 3a1 1 0 1 1-1 1 1.02 1.02 0 0 1 1-1ZM4.77 10a1.76 1.76 0 0 1 .88.25A9.98 9.98 0 0 0 3 11.92v-.14A1.78 1.78 0 0 1 4.78 10ZM12 21c-4.88 0-9-2.29-9-5s4.12-5 9-5 9 2.29 9 5-4.12 5-9 5Zm8.99-9.08a9.98 9.98 0 0 0-2.65-1.67 1.76 1.76 0 0 1 .88-.25A1.78 1.78 0 0 1 21 11.78l-.01.14Z" /></svg>
          r/MinusPod
        </a>
        <a href="https://buymeacoffee.com/ttlequals0">Buy me a coffee</a>
        <a href="https://ttlequals0.com">ttlequals0.com</a>
      </div>
    </footer>
  </body>
</html>
