{
  "name": "minuspod-landing",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // pages and videos go through the Worker (Markdown negotiation, byte ranges); other assets are served directly
    "run_worker_first": ["/*", "!/_astro/*", "!/brand/*", "!/screenshots/*", "!/videos/*.jpg", "!/.well-known/*", "!/*.xml", "!/*.txt", "!/*.md"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "minuspod.app/*", "zone_name": "minuspod.app" },
    { "pattern": "www.minuspod.app/*", "zone_name": "minuspod.app" }
  ]
}
