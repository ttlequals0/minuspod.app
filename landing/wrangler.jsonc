{
  "name": "minuspod-landing",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/videos/*.mp4"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "minuspod.app", "custom_domain": true }]
}
