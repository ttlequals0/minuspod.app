---
import ThemeControls from '../../../shared/theme/ThemeControls.astro';
---

<ThemeControls />

<script>
  import { initThemePicker } from '../../../shared/theme/picker.js';
  initThemePicker(document);
</script>

<style is:global>
  @layer starlight.components {
    .theme-picker {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .theme-pair {
      position: relative;
    }

    .theme-pair > summary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding-inline: 0.5rem;
      border-radius: 0.25rem;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      list-style: none;
      cursor: pointer;
      user-select: none;
    }

    .theme-pair > summary::-webkit-details-marker {
      display: none;
    }

    .theme-pair > summary:hover,
    .theme-pair[open] > summary,
    .theme-mode:hover {
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
    }

    .theme-pair > summary:focus-visible,
    .theme-mode:focus-visible,
    .theme-group button:focus-visible {
      outline: 2px solid var(--sl-color-accent);
    }

    .theme-pair .caret {
      flex: none;
      width: 1rem;
      height: 1rem;
    }

    .theme-pair[open] .caret {
      transform: rotate(180deg);
    }

    .theme-panel {
      position: absolute;
      top: calc(100% + 0.25rem);
      right: 0;
      z-index: var(--sl-z-index-menu);
      width: min(20rem, calc(100vw - 2rem));
      max-height: min(70vh, 34rem);
      overflow-y: auto;
      padding: 0.75rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      background: var(--sl-color-bg-nav);
      color: var(--sl-color-white);
      box-shadow: var(--sl-shadow-md);
    }

    .theme-note {
      margin: 0 0 0.75rem;
      padding-inline: 0.25rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }

    .theme-group + .theme-group {
      margin-top: 1rem;
    }

    .theme-group-title {
      margin: 0 0 0.5rem;
      padding-inline: 0.25rem;
      font-size: var(--sl-text-xs);
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--sl-color-gray-3);
    }

    .theme-group ul {
      display: grid;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .theme-group button {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      min-height: 2.75rem;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      background: var(--sl-color-bg);
      color: var(--sl-color-white);
      font: inherit;
      font-size: var(--sl-text-sm);
      line-height: 1.3;
      text-align: left;
      cursor: pointer;
    }

    .theme-group button:hover {
      background: var(--sl-color-gray-6);
    }

    .theme-group button[aria-pressed='true'] {
      border-color: var(--sl-color-accent);
      background: var(--sl-color-accent-low);
    }

    .theme-name {
      min-width: 0;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .theme-only {
      flex: none;
      margin-left: 0.25rem;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
    }

    .theme-group .check {
      display: none;
      flex: none;
      width: 1rem;
      height: 1rem;
      margin-left: auto;
      color: var(--sl-color-accent);
    }

    .theme-group button[aria-pressed='true'] .check {
      display: block;
    }

    .theme-picker .dot {
      flex: none;
      width: 0.75rem;
      height: 0.75rem;
      border-radius: 50%;
      background: var(--theme-accent, var(--sl-color-accent));
    }

    .theme-pair > summary .dot {
      width: 0.625rem;
      height: 0.625rem;
    }

    .theme-mode {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: 0;
      border-radius: 0.375rem;
      background: none;
      color: var(--sl-color-gray-2);
      cursor: pointer;
    }

    .theme-mode svg {
      display: none;
      width: 1.25rem;
      height: 1.25rem;
    }

    :root[data-theme='dark'] .theme-mode .icon-sun,
    :root:not([data-theme='dark']) .theme-mode .icon-moon {
      display: block;
    }

    /* inside the mobile menu the list expands in place */
    @media (max-width: 50rem) {
      .mobile-preferences .theme-picker {
        flex: 1 1 100%;
        padding-block: 0.25rem;
      }

      .mobile-preferences .theme-pair {
        flex: 1 1 auto;
        min-width: 0;
      }

      .mobile-preferences .theme-panel {
        position: static;
        width: auto;
        max-height: none;
        margin-top: 0.25rem;
        box-shadow: none;
      }
    }
  }
</style>
