{
  "name": "minuspod-docs",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // pages go through the Worker for Markdown negotiation; assets are served directly
    "run_worker_first": ["/*", "!/_astro/*", "!/pagefind/*", "!/images/*", "!/screenshots/*", "!/schemas/*", "!/examples/*", "!/.well-known/*", "!/*.svg", "!/*.xml", "!/*.txt", "!/*.md", "!/*.yaml", "!/*.json"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "docs.minuspod.app/*", "zone_name": "minuspod.app" }]
}
