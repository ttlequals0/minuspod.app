{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "minuspod-demo",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // a hard reload bypasses the mock service worker; answer /api/ with JSON instead of the SPA shell
    "run_worker_first": ["/api", "/api/*"]
  },
  "routes": [{ "pattern": "demo.minuspod.app", "custom_domain": true }]
}
